{
  "aircraft": "A320",
  "scenario": "Full servicing at a contact stand, one passenger bridge at door 1L",
  "source": "AC-A320 §5-2-0",
  "assumptions": {
    "pax": 150,
    "deplane_rate_pax_per_min": 20,
    "board_rate_pax_per_min": 12,
    "container_min_each": 1.5,
    "fwd_containers": 3,
    "aft_containers": 4,
    "bulk_kg": 500,
    "bulk_unload_kg_per_min": 150,
    "bulk_load_kg_per_min": 120,
    "fuel_litres": 20000,
    "catering_fste_1R": 4,
    "catering_fste_4R": 7,
    "catering_min_per_fste": 1.2,
    "catering_drive_1R_to_4R_min": 2,
    "position_and_open_min": 2,
    "close_and_remove_min": 1.5,
    "fuel_position_connect_remove_min": 2.5,
    "lps_headcount_min": 2,
    "no_refuel_with_pax_on_board": true
  },
  "target_trt_min": 44,
  "positions": {
    "_note": "x = metres aft of nose, y = metres from centreline (+ right, - left). AC-A320 §2-7-0, §5-4-x",
    "door_1L": { "x": 5.04, "y": -2.0 },
    "door_1R": { "x": 5.04, "y": 2.0 },
    "door_4R": { "x": 29.53, "y": 2.0 },
    "fwd_cargo_door": { "x": 8.16, "y": 2.0 },
    "aft_cargo_door": { "x": 22.69, "y": 2.0 },
    "bulk_cargo_door": { "x": 26.29, "y": 2.0 },
    "ground_power": { "x": 2.55, "y": 0 },
    "lp_air": { "x": 12.45, "y": -1.11 },
    "refuel_coupling_rh": { "x": 19.1, "y": 9.83 },
    "potable_water_panel": { "x": 31.3, "y": -0.3 },
    "waste_water_panel": { "x": 31.3, "y": 0.8 },
    "nose_gear": { "x": 5.07, "y": 0 }
  },
  "dimensions": { "length_m": 37.57, "span_m": 35.8, "fuselage_width_m": 3.95, "source": "AC-A320 §2-2-0" },
  "tasks": [
    { "id": "pbb_dock",      "label": "Bridge docks, door 1L opens", "equipment": "PBB",  "at": "door_1L", "start": 0,    "end": 2,    "after": [],                                  "read": "stated" },
    { "id": "deplane",       "label": "Deplaning",                   "equipment": "PBB",  "at": "door_1L", "start": 2,    "end": 9.5,  "after": ["pbb_dock"],                          "read": "stated", "critical": true },
    { "id": "cat_1R",        "label": "Catering at door 1R",         "equipment": "CAT",  "at": "door_1R", "position": [7.5, 9.5], "start": 9.5, "end": 14.3, "remove": [14.3, 15.8], "after": ["deplane"], "read": "stated", "critical": true },
    { "id": "cat_4R",        "label": "Catering at door 4R",         "equipment": "CAT",  "at": "door_4R", "position": [17.8, 19.8], "start": 19.8, "end": 28.2, "remove": [28.2, 29.7], "after": ["cat_1R"], "same_vehicle_as": "cat_1R", "read": "stated", "critical": true },
    { "id": "cleaning",      "label": "Cabin cleaning",              "equipment": null,   "at": "door_1L", "start": 9.5,  "end": 28.2, "after": ["deplane"],                           "read": "chart", "note": "in available time; crew uses the bridge" },
    { "id": "refuel",        "label": "Refuelling, right wing",      "equipment": "FUEL", "at": "refuel_coupling_rh", "position": [7, 9.5], "start": 9.5, "end": 25.6, "remove": [25.6, 28.1], "after": ["deplane"], "before": ["board"], "read": "chart" },
    { "id": "board",         "label": "Boarding",                    "equipment": "PBB",  "at": "door_1L", "start": 28.2, "end": 40.7, "after": ["cat_4R", "cleaning", "refuel"],      "read": "stated", "critical": true },
    { "id": "lps",           "label": "Last pax seated + headcount", "equipment": null,   "at": "door_1L", "start": 40.7, "end": 42.7, "after": ["board"],                             "read": "stated", "critical": true },
    { "id": "pbb_remove",    "label": "Door closes, bridge retracts","equipment": "PBB",  "at": "door_1L", "start": 42.7, "end": 44.2, "after": ["lps"],                               "read": "stated", "critical": true },
    { "id": "fwd_unload",    "label": "Fwd hold unload (3 ULD)",     "equipment": "LDCL", "at": "fwd_cargo_door", "position": [0, 2], "start": 2, "end": 6.5, "after": [],            "read": "stated" },
    { "id": "fwd_load",      "label": "Fwd hold load (3 ULD)",       "equipment": "LDCL", "at": "fwd_cargo_door", "start": 36, "end": 40.5, "remove": [40.5, 42], "after": ["fwd_unload"], "read": "chart" },
    { "id": "aft_unload",    "label": "Aft hold unload (4 ULD)",     "equipment": "LDCL", "at": "aft_cargo_door", "position": [0, 2], "start": 2, "end": 8, "after": [],              "read": "stated" },
    { "id": "aft_load",      "label": "Aft hold load (4 ULD)",       "equipment": "LDCL", "at": "aft_cargo_door", "start": 34.5, "end": 40.5, "remove": [40.5, 42], "after": ["aft_unload"], "read": "chart" },
    { "id": "bulk_unload",   "label": "Bulk hold unload (500 kg)",   "equipment": "CB",   "at": "bulk_cargo_door", "position": [0, 2], "start": 2, "end": 5.3, "after": [],             "read": "derived" },
    { "id": "bulk_load",     "label": "Bulk hold load (500 kg)",     "equipment": "CB",   "at": "bulk_cargo_door", "start": 36.3, "end": 40.5, "remove": [40.5, 42], "after": ["bulk_unload"], "read": "derived" },
    { "id": "waste_water",   "label": "Toilet servicing",            "equipment": "LV",   "at": "waste_water_panel", "position": [0, 2], "start": 2, "end": 6, "remove": [6, 8], "after": [], "read": "chart" },
    { "id": "potable_water", "label": "Potable water (200 l)",       "equipment": "WV",   "at": "potable_water_panel", "position": [8, 10], "start": 10, "end": 15, "remove": [15, 17], "after": ["waste_water"], "read": "chart" },
    { "id": "gpu",           "label": "Ground power",                "equipment": "GPU",  "at": "ground_power", "position": [0, 1], "start": 1, "end": 42, "after": [], "read": "game", "note": "manual: other equipment starts at t0 but is not charted; hook-up minute and end are our assumption" },
    { "id": "pca",           "label": "Air conditioning, one hose",  "equipment": "AC",   "at": "lp_air", "position": [0, 1], "start": 1, "end": 42, "after": [], "read": "game", "note": "as ground power" },
    { "id": "pushback",      "label": "Tug connects, off-blocks",    "equipment": "TOW",  "at": "nose_gear", "position": [40, 42], "start": 44.2, "end": 44.2, "after": ["pbb_remove", "fwd_load", "aft_load", "bulk_load", "gpu", "pca"], "read": "game", "note": "manual ends at bridge removal; tug timing is our assumption" }
  ],
  "vehicles": {
    "_note": "GSE types from AC-A320 §5-1-1. Trains are tractor + dollies feeding the loaders.",
    "CAT": "catering truck (1, serves 1R then 4R)",
    "FUEL": "fuel hydrant dispenser",
    "LDCL": "lower deck cargo loader (2: fwd, aft)",
    "CB": "conveyor belt loader (1: bulk)",
    "ULD": "ULD train (2: fwd, aft)",
    "BULK": "bulk baggage train (1)",
    "LV": "lavatory vehicle",
    "WV": "potable water vehicle",
    "GPU": "ground power unit",
    "AC": "air conditioning unit",
    "TOW": "pushback tractor"
  }
}
